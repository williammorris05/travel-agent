# Copy to backend/.env for local overrides. No credentials are required for L0.
TRAVEL_DATA_MODE=fixture
# live uses the hotel pilot when configured; never falls back to fixtures.
# TRAVEL_DATA_MODE=live
# Chat remains disabled until explicitly configured. Use a free-tier Gemini project
# without billing for no-cost testing. Never put a key in frontend code or chat.
TRAVEL_MODEL_PROVIDER=disabled
TRAVEL_MODEL_NAME=gemini-3.8-flash
TRAVEL_MODEL_MAX_CALLS=0
# To enable after setting a key: provider=gemini, max_calls=10.
# TRAVEL_GEMINI_API_KEY=replace-locally
# Optional alternative: provider=openai, model_name=<chosen-model>
# TRAVEL_OPENAI_API_KEY=replace-locally

# Hotel pilot: Milwaukee, fixed dates, one room and 1–2 adults.
# A key alone does not enable calls. Confirm free-plan allowance before enabling.
# TRAVEL_SERPAPI_API_KEY=replace-locally
TRAVEL_HOTEL_MAX_CALLS=0
# To enable: data_mode=live and hotel_max_calls=3, then restart the backend.
